{
  "name": "smj",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon --ignore backend/backups/** --ignore backend/uploads/** backend/server.js",
    "rag:reindex": "node backend/scripts/reindexAiKnowledge.js --days 90",
    "rag:reindex:all": "node backend/scripts/reindexAiKnowledge.js --all",
    "frontend:build": "cd frontend && npm run build",
    "electron:dev": "npm run frontend:build && cross-env NODE_ENV=electron-dev electron .",
    "electron:start": "npm run frontend:build && cross-env NODE_ENV=desktop electron .",
    "electron:build": "npm run frontend:build && electron-builder --win",
    "electron:build:publish": "npm run frontend:build && electron-builder --win --publish always"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hira-Safdar/SMJ.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Hira-Safdar/SMJ/issues"
  },
  "homepage": "https://github.com/Hira-Safdar/SMJ#readme",
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.577.0",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "react-hot-toast": "^2.6.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.10"
  },
  "build": {
    "appId": "com.smj.ricemill",
    "productName": "SMJ Rice Mill",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "backend/**/*",
      "frontend/dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      ".env",
      "package.json",
      "!backend/backups",
      "!backend/uploads/logo-*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/public/logo-1769953313128-favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "frontend/public/logo-1769953313128-favicon.png",
      "uninstallerIcon": "frontend/public/logo-1769953313128-favicon.png",
      "installerHeaderIcon": "frontend/public/logo-1769953313128-favicon.png"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "core-js@3.48.0": true
  }
}
